<h1>Book Collection</h1>

<% if flash[:notice] %>
  <div class="flash-notice"><%= flash[:notice] %></div>
<% end %>

<table>
  <thead>
    <tr>
      <th>Title</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @books.each do |book| %>
      <tr>
        <td><%= book.title %></td>
        <td>
          <%= link_to "Show", book_path(book) %>
          <%= link_to "Edit", edit_book_path(book) %>
          <%= link_to "Delete",
          book_path(book),
          data: {
            turbo_method: :delete,
            turbo_confirm: "Are you sure?",
          } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to "Add New Book", new_book_path %>
