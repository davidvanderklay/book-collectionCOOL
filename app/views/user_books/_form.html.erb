<%= form_with(model: user_book, local: true) do |form| %>
  <% if user_book.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(user_book.errors.count, "error") %>
        prohibited this user_book from being saved:</h2>

      <ul>
        <% user_book.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :user_id %>
    <%= form.select :user_id,
                User.order(:username).map { |user| [user.username, user.id] },
                include_blank: true,
                id: "user_id_select" %>
  </div>

  <div class="field">
    <%= form.label :book_id %>
    <%= form.select :book_id,
                Book.order(:title).map { |book| [book.title, book.id] },
                include_blank: true,
                id: "book_id_select" %>
  </div>

  <div class="actions">
    <%= form.submit %>
  </div>
<% end %>
